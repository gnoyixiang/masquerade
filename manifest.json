{
  "manifest_version": 3,
  "name": "Masquerade — User-Agent Switcher",
  "version": "1.2.2",
  "description": "Switch Chrome's server-facing and per-tab JavaScript User-Agent with practical device presets.",
  "minimum_chrome_version": "102",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Masquerade — User-Agent Switcher"
  },
  "icons": {
    "16": "icons/masquerade-16.png",
    "32": "icons/masquerade-32.png",
    "48": "icons/masquerade-48.png",
    "128": "icons/masquerade-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
